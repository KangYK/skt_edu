{
  "name": "customer-support-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "demo": "node server/index.mjs --demo",
    "setup": "node --env-file-if-exists=.env scripts/setup.mjs",
    "test": "node --test tests/*.test.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "build": "node scripts/build-static.mjs",
    "test:static": "node --test tests/static-demo.test.mjs"
  }
}

# Copy to .env for the live local service. Demo always uses a separate directory.
HOST=127.0.0.1
PORT=4310
APP_ORIGIN=http://127.0.0.1:4310
DATA_DIR=./data/live
# Enable behind an HTTPS reverse proxy; APP_ORIGIN must then use https.
SECURE_COOKIES=false
# For public production deployment set NODE_ENV=production and SECURE_COOKIES=true.
# Company SSO, email delivery and CRM integration are not connected yet.
